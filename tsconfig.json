{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"]
  },
  "include": ["tests/**/*.ts", "utils/**/*.ts", "scripts/**/*.ts", "playwright.config.ts"]
}
